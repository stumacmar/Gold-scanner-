# Copy this file to ".env" and fill in your keys. Never commit the real .env.

# --- Required: eBay Browse API (production keyset) ---------------------------
# Get these at https://developer.ebay.com -> Application Keys -> Production.
# The Browse API uses an OAuth2 *application* token (client-credentials);
# the scanner fetches and caches that token for you from these two values.
EBAY_CLIENT_ID=YourProductionAppId
EBAY_CLIENT_SECRET=YourProductionCertId

# --- Optional: live gold price provider -------------------------------------
# Set ONE of these depending on SPOT_PROVIDER in gold_ring_scanner.py.
# If neither is set, the script uses the SPOT_PRICE_GBP_PER_OZ fallback constant.
METALS_API_KEY=
GOLDAPI_KEY=
